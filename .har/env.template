# Agent environment — generated by launch.sh from env.template
# DO NOT EDIT — regenerated on every launch
AGENT_ID=${AGENT_ID}

# Ports — this repo is a single Next.js app (frontend + API routes/server
# actions all in one process), so FE_PORT and API_PORT are the same port.
# May differ from BASE + AGENT_ID × STEP when busy — see .har/harness.env.
PORT=${FE_PORT}
FE_PORT=${FE_PORT}
API_PORT=${API_PORT}
DEBUG_PORT=${DEBUG_PORT}

# Application
NODE_ENV=development

# Supabase — ONE shared local stack serves every agent slot (see
# .har/setup-infra.sh and supabase/config.toml). Same URL/keys for all slots.
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY}

# Server-side/admin use only (bypasses Row Level Security) — never expose to
# the browser. Handy for scripts run via `./.har/agent-cli.sh <id> exec`.
SUPABASE_SECRET_KEY=${SUPABASE_SECRET_KEY}
SUPABASE_DB_URL=${SUPABASE_DB_URL}

# Toolchain paths — appended by provision-toolchain.sh during launch
# NODE_BIN=  NPM_BIN=
