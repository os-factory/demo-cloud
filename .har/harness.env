# Shared harness configuration — edit to match your project
# Generated by har env init, maintained over time with har env maintain

export HARNESS_PROJECT_NAME=next_supabase
export HARNESS_USE_WORKTREE=true

# Primary application — the ONE app agents modify and run per-slot. This repo
# is a single Next.js app (frontend + server actions/route handlers all in one
# process) — there is no separate backend service.
export HARNESS_PRIMARY_APP=app

# ── Per-slot app ports (PM2 / primary app) ────────────────────────────────────
# Next.js serves the frontend AND any API routes/server actions from the same
# process, so FE_BASE and API_BASE are intentionally equal — FE_PORT and
# API_PORT will resolve to the same port for a given slot. Scripts still carry
# both names for compatibility with the generic harness tooling.
# Defaults: BASE + (AGENT_ID × HARNESS_PORT_STEP). launch.sh scans the slot lane
# when busy and writes resolved FE_PORT / API_PORT / DEBUG_PORT to .env.agent.<id>.
export HARNESS_FE_BASE_PORT=3000
export HARNESS_API_BASE_PORT=3000
export HARNESS_PORT_STEP=10
export HARNESS_HEALTH_CHECK_PATH=/api/health

# ── Shared infra: local Supabase stack ─────────────────────────────────────────
# Supabase is a shared dependency for every agent slot — ONE local stack
# (Postgres, Auth/GoTrue, PostgREST, Kong, Studio, Mailpit) is started once by
# setup-infra.sh via the Supabase CLI and reused by all slots on fixed ports.
#
# This does NOT go through docker-compose.agent.yml/HARNESS_INFRA_SERVICES —
# the Supabase CLI manages its own Docker containers from
# supabase/config.toml (repo root, committed). There is no docker-compose.agent.yml
# in this harness; HARNESS_INFRA_SERVICES is intentionally empty.
export HARNESS_INFRA_SERVICES=""

# Must match `project_id` in supabase/config.toml — used to address the
# Supabase-managed containers directly (e.g. supabase_db_<id> for psql).
export HARNESS_SUPABASE_PROJECT_ID="next-supabase"

# Ports below are fixed in supabase/config.toml (not scanned/reallocated by
# this harness — Supabase is a single shared instance, so conflicts are rare
# and surfaced directly by `supabase start`). Documented here for reference —
# see .har/README.md "Port & shared services" and supabase/config.toml.
#   API (Kong)     54321
#   Postgres       54322
#   Studio         54323
#   Mailpit (mail testing UI) 54324
# On conflict: edit the ports in supabase/config.toml, then `supabase stop &&
# supabase start` (or `./.har/setup-infra.sh`).

# Postgres client for the shared Supabase database — uses host tools when
# installed, otherwise docker exec into the Supabase-managed container.
# Usage: har_pg psql -c "SELECT 1"
har_pg() {
  local tool="$1"; shift
  local state_file="${SCRIPT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}/state/supabase.env"
  # shellcheck source=/dev/null
  [ -f "$state_file" ] && source "$state_file"
  if command -v "$tool" >/dev/null 2>&1 && [ -n "${SUPABASE_DB_URL:-}" ]; then
    "$tool" "$SUPABASE_DB_URL" "$@"
  else
    docker exec -i -e PGPASSWORD=postgres "supabase_db_${HARNESS_SUPABASE_PROJECT_ID}" "$tool" -U postgres "$@"
  fi
}

# Agent slot limits — canonical source: .har/stages.json (agentSlots).
# Legacy fallback below; har env maintain --finalize syncs these from stages.json.
export HARNESS_AGENT_SLOT_MIN=1
export HARNESS_AGENT_SLOT_MAX=5

# Toolchain provisioning — launch writes resolved paths into .env.agent.<id>
# Ecosystem: auto (detect from manifests) | node | python | go | rust | java | ruby | none
export HARNESS_ECOSYSTEM="node"

# No database migrate/seed hooks: this starter app only uses Supabase Auth (no
# custom tables), and Supabase's own migration system (supabase/migrations/,
# applied automatically by `supabase start` / `supabase db reset`) owns schema
# changes if you add tables later — it does not go through this harness.

# "Agent usable" beyond a health check: verifies the frontend is wired to
# Supabase and that a real sign-up returns a session (email confirmations are
# disabled for local dev in supabase/config.toml).
export HARNESS_READINESS_CMD="./.har/readiness.sh {agentId}"
