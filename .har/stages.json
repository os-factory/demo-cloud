{
  "version": "1",
  "artifactsDir": "artifacts",
  "logsDir": "logs",
  "agentSlots": {
    "min": 1,
    "max": 5
  },
  "stages": [
    {
      "id": "setup-infra",
      "kind": "setup",
      "description": "Shared local Supabase stack (Postgres, Auth, REST, Studio, Mailpit) via the Supabase CLI",
      "command": "./.har/setup-infra.sh",
      "artifacts": []
    },
    {
      "id": "launch",
      "kind": "launch",
      "description": "Launch an isolated agent environment slot",
      "command": "./.har/launch.sh {agentId}",
      "artifacts": [
        {
          "path": ".env.agent.{agentId}",
          "kind": "file",
          "description": "Generated per-agent environment file in the session work dir"
        }
      ]
    },
    {
      "id": "verify",
      "kind": "verify",
      "description": "Verification pipeline (quick smoke by default; --full runs the registry's verificationStages)",
      "command": "./.har/verify.sh {agentId}",
      "artifacts": [
        {
          "path": ".har/artifacts",
          "kind": "directory",
          "description": "Optional verification outputs such as reports, traces, screenshots, and logs"
        }
      ],
      "acceptsArgs": [
        "--full"
      ]
    },
    {
      "id": "status",
      "kind": "inspect",
      "description": "Inspect a running agent environment slot",
      "command": "./.har/agent-cli.sh {agentId} status",
      "artifacts": [
        {
          "path": ".har/logs",
          "kind": "directory",
          "description": "Optional harness logs"
        }
      ]
    },
    {
      "id": "logs",
      "kind": "inspect",
      "description": "Read recent logs for an agent slot",
      "command": "./.har/agent-cli.sh {agentId} logs",
      "artifacts": []
    },
    {
      "id": "teardown",
      "kind": "teardown",
      "description": "Stop processes and release agent slot resources",
      "command": "./.har/teardown.sh {agentId}",
      "artifacts": []
    }
  ],
  "commitGate": {
    "enabled": true,
    "mode": "block",
    "scope": "worktrees"
  }
}
