{
  "version": "1",
  "artifactsDir": "artifacts",
  "logsDir": "logs",
  "agentSlots": {
    "min": 1,
    "max": 5
  },
  "verificationStages": [
    "factory-line-catalog",
    "typecheck",
    "unit-tests",
    "api-health",
    "lint",
    "browser-e2e"
  ],
  "stages": [
    {
      "id": "setup-infra",
      "kind": "setup",
      "description": "Shared local Supabase stack (Postgres, Auth, REST, Studio, Mailpit) via the Supabase CLI",
      "command": "./.har/setup-infra.sh",
      "artifacts": []
    },
    {
      "id": "launch",
      "kind": "launch",
      "description": "Launch an isolated agent environment slot",
      "command": "./.har/launch.sh {agentId}",
      "artifacts": [
        {
          "path": ".env.agent.{agentId}",
          "kind": "file",
          "description": "Generated per-agent environment file in the session work dir"
        }
      ]
    },
    {
      "id": "verify",
      "kind": "verify",
      "description": "Verification pipeline (quick smoke by default; --full runs the registry's verificationStages: factory-line-catalog, typecheck, unit-tests, api-health, lint, browser-e2e)",
      "command": "./.har/verify.sh {agentId}",
      "artifacts": [
        {
          "path": ".har/artifacts",
          "kind": "directory",
          "description": "Optional verification outputs such as reports, traces, screenshots, and logs"
        }
      ],
      "acceptsArgs": [
        "--full"
      ]
    },
    {
      "id": "status",
      "kind": "inspect",
      "description": "Inspect a running agent environment slot",
      "command": "./.har/agent-cli.sh {agentId} status",
      "artifacts": [
        {
          "path": ".har/logs",
          "kind": "directory",
          "description": "Optional harness logs"
        }
      ]
    },
    {
      "id": "logs",
      "kind": "inspect",
      "description": "Read recent logs for an agent slot",
      "command": "./.har/agent-cli.sh {agentId} logs",
      "artifacts": []
    },
    {
      "id": "factory-line",
      "kind": "custom",
      "description": "Run a factory line (default: production-reproducibility seeding profile from task context)",
      "script": "stages/factory-line.sh",
      "artifacts": [
        {
          "path": ".har/artifacts/factory-line",
          "kind": "directory",
          "description": "Applied profile, SQL, and domain-state proof"
        }
      ],
      "group": "factory-line",
      "acceptsArgs": [
        "--line",
        "--profile",
        "--context",
        "--list",
        "--dry-run",
        "--verify-only"
      ]
    },
    {
      "id": "factory-line-catalog",
      "kind": "test",
      "description": "Validate factory-line registry, seeding profiles, and context routing (no database writes)",
      "script": "stages/factory-line-catalog.sh",
      "artifacts": [
        {
          "path": ".har/artifacts/factory-line-catalog",
          "kind": "directory",
          "description": "Catalog check output"
        }
      ],
      "group": "factory-line"
    },
    {
      "id": "teardown",
      "kind": "teardown",
      "description": "Stop processes and release agent slot resources",
      "command": "./.har/teardown.sh {agentId}",
      "artifacts": []
    },
    {
      "id": "browser-e2e",
      "kind": "test",
      "description": "Playwright E2E (frontend + API + a11y)",
      "script": "stages/browser-e2e.sh",
      "artifacts": [
        {
          "path": ".har/artifacts/browser-e2e",
          "kind": "directory",
          "description": "HTML report, traces, screenshots, videos"
        },
        {
          "path": ".har/artifacts/browser-e2e/handoff",
          "kind": "directory",
          "description": "Named PNGs of changed UI for the session handoff"
        },
        {
          "path": ".har/artifacts/browser-e2e/playwright-report",
          "kind": "report"
        }
      ],
      "requiresAgentId": true
    }
  ],
  "commitGate": {
    "enabled": true,
    "mode": "block",
    "scope": "worktrees"
  }
}
